# Postgres connection string (Neon or Cursor Apps). Leave unset for local PGlite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional: direct (non-pooled) URL for migrations on Neon.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Resend — required to email waitlist confirmations in production.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=TEQUEBOX <hola@tu-dominio.com>

# Optional: get a copy of every new waitlist signup.
LEADS_NOTIFY_EMAIL=tu@email.com
